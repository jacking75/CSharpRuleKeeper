root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4
tab_width = 4

csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:error
csharp_preserve_single_line_blocks = false
csharp_preserve_single_line_statements = false

dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion

# private/internal 필드의 _, s_, t_ 구분은 HBCS014가 특성까지 확인해 적용한다.

dotnet_naming_rule.types.severity = error
dotnet_naming_rule.types.symbols = types
dotnet_naming_rule.types.style = pascal_case
dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum, delegate

dotnet_naming_rule.public_members.severity = error
dotnet_naming_rule.public_members.symbols = public_members
dotnet_naming_rule.public_members.style = pascal_case
dotnet_naming_symbols.public_members.applicable_kinds = property, event, field
dotnet_naming_symbols.public_members.applicable_accessibilities = public, protected, protected_internal

dotnet_naming_rule.methods.severity = error
dotnet_naming_rule.methods.symbols = methods
dotnet_naming_rule.methods.style = pascal_case
dotnet_naming_symbols.methods.applicable_kinds = method

dotnet_naming_rule.enum_values.severity = error
dotnet_naming_rule.enum_values.symbols = enum_values
dotnet_naming_rule.enum_values.style = pascal_case
dotnet_naming_symbols.enum_values.applicable_kinds = field
dotnet_naming_symbols.enum_values.required_modifiers = const
dotnet_naming_symbols.enum_values.applicable_accessibilities = public

dotnet_naming_rule.locals_and_parameters.severity = error
dotnet_naming_rule.locals_and_parameters.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters.style = camel_case
dotnet_naming_symbols.locals_and_parameters.applicable_kinds = local, parameter

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case

personal_csharp_rules.method_lines_warning = 30
personal_csharp_rules.method_lines_error = 100
personal_csharp_rules.type_lines_warning = 300
personal_csharp_rules.type_lines_error = 500
personal_csharp_rules.max_line_length = 120
personal_csharp_rules.allow_magic_numbers = -1,0,1,2
personal_csharp_rules.analyze_test_projects = false
personal_csharp_rules.public_field_allowed_attributes =
personal_csharp_rules.type_length_excluded_suffixes =

[*.{csproj,props,targets,slnx}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
