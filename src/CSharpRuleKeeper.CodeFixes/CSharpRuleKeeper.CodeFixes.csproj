<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>CSharpRuleKeeper.CodeFixes</AssemblyName>
    <RootNamespace>CSharpRuleKeeper.CodeFixes</RootNamespace>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>CSharpRuleKeeper</PackageId>
    <PackageType>Analyzer</PackageType>
    <DevelopmentDependency>true</DevelopmentDependency>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <Authors>Choi HeungBae</Authors>
    <Copyright>Copyright (c) 2026 Choi HeungBae</Copyright>
    <PackageProjectUrl>https://github.com/jacking75/CSharpRuleKeeper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jacking75/CSharpRuleKeeper</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>roslyn;analyzer;csharp;code-quality;coding-agent;lint</PackageTags>
    <Description>Roslyn analyzers that check C# code, including code written by AI coding agents, against a configurable set of naming, length, magic-number and layout rules (HBCS001-HBCS015), with a safe nameof code fix. Limits and exceptions are set through .editorconfig.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSharpRuleKeeper.Analyzers\CSharpRuleKeeper.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(MSBuildProjectDirectory)\..\CSharpRuleKeeper.Analyzers\bin\$(Configuration)\netstandard2.0\CSharpRuleKeeper.Analyzers.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>
</Project>
