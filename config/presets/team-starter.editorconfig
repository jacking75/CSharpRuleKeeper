root = true

[*.{cs,csx}]
# Adopt contract-safe and clearly wrong patterns first. HBCS001 and HBCS014 are errors by default, so they are
# not listed: an explicit "= error" would make the standalone checker stop compiling a project that violates
# them (see docs/CONFIGURATION.md, "Severities under the checker").
dotnet_diagnostic.HBCS004.severity = warning

# Until the team agrees on taste rules, keep them informational or off.
dotnet_diagnostic.HBCS003.severity = suggestion
dotnet_diagnostic.HBCS008.severity = none
dotnet_diagnostic.HBCS011.severity = none
dotnet_diagnostic.HBCS013.severity = suggestion

personal_csharp_rules.method_lines_warning = 50
personal_csharp_rules.method_lines_error = 120
personal_csharp_rules.type_lines_warning = 400
personal_csharp_rules.type_lines_error = 600
personal_csharp_rules.file_lines_warning = 700
personal_csharp_rules.file_lines_error = 1200
personal_csharp_rules.public_field_allowed_attributes = System.Runtime.InteropServices.StructLayoutAttribute,System.Runtime.Serialization.DataMemberAttribute

# Set Unity and serialization exceptions in the narrowest sub-folder .editorconfig of the real target.
# This example does not mean full Unity support.
